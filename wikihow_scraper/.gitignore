# Sensitive: plaintext credentials and live login sessions/cookies per profile.
# Only the placeholder credentials.json (unfilled) should ever be shared - a filled-in
# one contains a real plaintext password, and the rest of a profile dir is a live
# Chrome user-data-dir (cookies, session tokens) tied to a real logged-in account.
data/profiles/*/credentials.json
data/profiles/*/Default/
data/profiles/*/Local State
data/profiles/*/lockfile
data/profiles/*/account_info.json

# Transient runtime state - regenerated on demand, not meaningful to share.
data/tor_runtime/
data/profiles/active_tor_ports.json
logs/

# Python housekeeping.
__pycache__/
*.pyc

# Local scratch/test scripts - one-off investigation scripts, not part of the package.
scratch/
