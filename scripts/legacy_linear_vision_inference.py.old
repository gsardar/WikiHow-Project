import os
import time
import random
import pandas as pd
from seleniumbase import Driver
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
from selenium.webdriver.common.by import By

# --- CONFIG ---
WORKSPACE_DIR = r"c:\Users\Admin\Documents\WikiHow Project"
ACCOUNTS_DIR  = os.path.join(WORKSPACE_DIR, "data", "DataVersions", "v1", "accounts")
BROWSER_DATA  = os.path.join(WORKSPACE_DIR, "data", "browser_session")
TEMP_IMAGE    = os.path.join(WORKSPACE_DIR, "data", "temp_vision_audit.png")

# -- Verified XPaths (audited via native browser inspection) ------------------
#
# These selectors use contains() so they survive DOM subscript shifts that
# happen when DeepSeek transitions from Fresh Chat ? Active Thread.
#
# State A  (Fresh chat, no file):
#   Textarea : //textarea[@placeholder='Message DeepSeek']
#   Upload   : //div[contains(@class,'f02f0e25')]
#   Send     : //div[contains(@class,'_52c986b')]   ? disabled until text typed
#
# State B  (After file attached):
#   Preview  : //div[contains(@class,'_76cd190')]   ? appears above textarea
#   Textarea : same selector still resolves (class-based, not index-based)
#   Send     : same selector, but 'ds-icon-button--disabled' class REMOVED
#              once BOTH file AND text are present
#
# State C  (Thread ? second+ message):
#   Input bar moves to bottom; textarea/upload/send selectors remain the same
#   because they are class-based, not absolute-index-based.
#
# Completion Signal:
#   The "Copy" or "Share" button row appears once generation is done.
#   We detect completion by watching the Send button re-appear (disabled?gone)
#   and the Stop-Generating button disappear.
#   Selector: div[aria-label='Stop'] disappears ? response is stable.
# -----------------------------------------------------------------------------

XPATH_TEXTAREA  = "//textarea[@placeholder='Message DeepSeek']"
XPATH_FILE_INPUT = "//input[@type='file']"
XPATH_PREVIEW   = "//div[contains(@class,'_76cd190')]"
XPATH_SEND      = "//div[contains(@class,'_52c986b')]"
XPATH_STOP_GEN  = "//*[@aria-label='Stop' or contains(@aria-label,'Stop')]"


def _wait_for_new_preview(driver, initial_count, timeout=20):
    """Wait until a NEW preview thumbnail appears (count increases)."""
    start = time.time()
    while time.time() - start < timeout:
        current = len(driver.find_elements("xpath", XPATH_PREVIEW))
        if current > initial_count:
            return True
        time.sleep(1)
    return False


def _wait_for_send_enabled(driver, timeout=20):
    """Poll until the Send button exists AND does not carry the disabled class."""
    start = time.time()
    while time.time() - start < timeout:
        btns = driver.find_elements("xpath", XPATH_SEND)
        if btns:
            cls = btns[-1].get_attribute("class") or ""
            if "disabled" not in cls.lower():
                return btns[-1]
        time.sleep(1)
    return None


def _wait_for_response_stable(driver, timeout=180):
    """
    Poll until generation is complete.
    Completion = Stop button gone AND .ds-markdown text unchanged for 3 cycles.
    """
    last_len    = 0
    stable_count = 0
    print("  [Hub] Waiting for response", end="", flush=True)

    for _ in range(timeout // 2):
        time.sleep(2)
        print(".", end="", flush=True)

        # Step 1 ? Stop button still visible? DeepSeek is still generating.
        stop_btns = driver.find_elements("xpath", XPATH_STOP_GEN)
        if stop_btns:
            stable_count = 0
            continue

        # Step 2 ? Check if any response has appeared yet
        msgs = driver.find_elements("css selector", ".ds-markdown")
        if not msgs:
            continue

        curr_len = len(msgs[-1].text)

        if curr_len > 0 and curr_len == last_len:
            stable_count += 1
        else:
            stable_count = 0

        last_len = curr_len

        if stable_count >= 3:
            print(f"\n  [Hub] Response complete ({curr_len} chars).")
            return msgs[-1].text

    print("\n  [Warning] Response timed out.")
    msgs = driver.find_elements("css selector", ".ds-markdown")
    return msgs[-1].text if msgs else "Timeout: no response"


import ctypes

# -- CAPTCHA Detection Handshake -----------------------------------------------
def handle_captcha(driver):
    """Detects verification challenges and pops up a desktop alert."""
    captcha_selectors = [
        "iframe[src*='cloudflare']", 
        "#cf-turnstile-wrapper",
        "div.cf-turnstile"
    ]
    
    challenge_found = False
    try:
        for sel in captcha_selectors:
            if driver.find_elements("css selector", sel):
                challenge_found = True
                break
        if "just a moment" in driver.title.lower():
            challenge_found = True
    except: pass
    
    if challenge_found:
        print("\n[ACTION REQUIRED] CAPTCHA detected. Popup showing on desktop...")
        ctypes.windll.user32.MessageBoxW(0, "DeepSeek CAPTCHA detected!\n\nPlease solve the challenge in the browser window, then click OK here.", "Automation Handshake", 0x40000 | 0x30)
        # Wait a moment for UI to settle after manual solve
        time.sleep(3)

def _wait_for_upload_ready(driver, initial_count, timeout=60):
    """Waits for new thumbnail AND for 'Parsing...' to finish."""
    print("  [Upload] Waiting for 'Parsing...' to complete...")
    for _ in range(timeout):
        try:
            previews = driver.find_elements("xpath", XPATH_PREVIEW)
            if len(previews) > initial_count:
                # Check the text of the latest preview
                latest_text = previews[-1].text
                if "parsing" not in latest_text.lower() and len(latest_text.strip()) > 3:
                    print(f"  [Upload] [OK] File ready: {latest_text.strip()}")
                    return True
        except: pass
        time.sleep(1)
    return False

# -----------------------------------------------------------------------------

def run_linear_vision(sample_size=5):
    all_users = pd.read_csv(
        os.path.join(ACCOUNTS_DIR, "all_discovered_users.csv")
    )["username"].tolist()

    sample = random.sample(all_users, min(len(all_users), sample_size))
    if "Sophia B" not in sample:
        sample[0] = "Sophia B"

    print(f"Starting Linear Vision Inference on {len(sample)} users...")

    driver = Driver(uc=True, headless=False, user_data_dir=BROWSER_DATA)
    results = []

    try:
        # -- Setup: Initial DeepSeek Handshake -----------------------
        print("  [Setup] Initializing Primary Tab...")
        driver.get("https://chat.deepseek.com")
        
        print("\n" + "!"*60)
        print("ACTION REQUIRED: Please check the browser window.")
        print("1. Resolve any CAPTCHAs or Cloudflare 'Verify you are human' prompts.")
        print("2. Ensure you are at the DeepSeek Chat interface.")
        print("3. Return to this console and press ENTER when ready.")
        print("!"*60 + "\n")
        
        input("Press ENTER to start the automation...")
        
        # Verify state after user intervention
        handle_captcha(driver)
        print("  [Setup] [OK] Global state verified.")

        for idx, u in enumerate(sample):
            print(f"\n-- Target {idx+1}/{len(sample)}: {u} --")
            
            # 1. Capture Phase: Navigate to WikiHow -------------------------
            profile_url = f"https://www.wikihow.com/User:{u.replace(' ', '_')}"
            print(f"  [Probe] Visiting {profile_url}")
            driver.get(profile_url)
            time.sleep(3)
            driver.save_screenshot(TEMP_IMAGE)
            print("  [Capture] [OK] Context synchronized.")

            # 2. Inference Phase: Navigate to DeepSeek Hub ------------------
            print("  [Hub] Re-entering DeepSeek...")
            driver.get("https://chat.deepseek.com")
            handle_captcha(driver)
            
            try:
                # -- MASTER XPATH MAPPING (from SBaseRecorder) ------------------------
                # Using relative anchors for 100% state-resilience.
                TEXTAREA_XPATH   = "//textarea[contains(@placeholder, 'DeepSeek')]"
                FILE_INPUT_XPATH = "//input[@type='file']"
                SEND_BTN_XPATH   = "//div[@role='button' and contains(@class, '_7436101')]"
                
                # -- 1. Upload File ---------------------------------------------------
                initial_previews = len(driver.find_elements("xpath", XPATH_PREVIEW))
                file_input = driver.find_element("xpath", FILE_INPUT_XPATH)
                file_input.send_keys(os.path.abspath(TEMP_IMAGE))
                print(f"  [Hub] Uploading image (Current: {initial_previews})...")
                
                # Wait for thumbnail HANDSHAKE (Wait for parsing to finish)
                if not _wait_for_upload_ready(driver, initial_previews):
                    print("  [Warning] Upload handshake timed out.")
                
                # -- 2. Type Prompt --------------------------------------------------
                time.sleep(2) # UI Settle
                textarea = driver.find_element("xpath", TEXTAREA_XPATH)
                prompt = f"Profile Context: {u}. Based on the attached wikiHow screenshot, determine the likely gender. Return: Gender, Reason, Evidence Tags."
                textarea.send_keys(prompt)
                print("  [Prompt] Sequence encoded.")
                
                # -- 3. Dispatch (Physical Click) ------------------------------------
                time.sleep(1)
                send_btn = driver.find_element("xpath", SEND_BTN_XPATH)
                
                # Wait for button ENABLED state
                for _ in range(15):
                    if "disabled" not in send_btn.get_attribute("class").lower():
                        send_btn.click()
                        print("  [Send] [OK] Physical Dispatch Successful.")
                        break
                    time.sleep(1)
                else:
                    print("  [Warning] Send button remained disabled. Forcing Enter...")
                    textarea.send_keys("\n")

                # -- STEP 7: Wait for full response (Stop btn gone + stable) ---
                verdict = _wait_for_response_stable(driver)
                print(f"  [Result] {verdict[:120]}...")
                results.append({"username": u, "llm_verdict": verdict})

                # -- STEP 8: Save Progress (Real-time Flush) --------------------------
                out_path = os.path.join(ACCOUNTS_DIR, "linear_vision_results.csv")
                pd.DataFrame(results).to_csv(out_path, index=False)
                print(f"  [Save] [OK] {u} data flushed to disk.")

            except Exception as e:
                print(f"  [Error] Inference failed for {u}: {e}")
                results.append({"username": u, "llm_verdict": f"Error: {e}"})

    finally:
        driver.quit()


if __name__ == "__main__":
    # Kill any existing Chrome sessions to ensure clean state
    os.system("taskkill /F /IM chrome.exe /T 2>nul")
    time.sleep(2)
    run_linear_vision(5)
