        {
            "id": "12889595",
            "user": "Wikivid",
            "timestamp": "09:50, 5 March 2014",
            "anon": false,
            "size": "(3,738 bytes)",
            "change": 151,
            "summary": "(Saving new step-by-step videos)",
            "is_minor": false,
            "is_expert": false,
            "status": "active",
            "contribution_type": "addition",
            "exact_contribution": {
                "added": [
                    "Many recipes for baked goods call for the baking pan or cake pan to be greased and floured prior to adding the batter and baking. This is an important step in the baking process to ensure that the finished product doesn't stick to the sides of the pan. Even non-stick pans need to be greased and floured for some recipes. By greasing and flouring the pan you're creating 2 layers of non-stick protection. The greasing agent will allow the flour to adhere to it and as the cake bakes, it will cling to the flour and not to the side of the pan. When baked and cooled the product should release from the pan easily. To do this, all you'll need are the right ingredients and a little practice.",
                    "#Choose your greasing agent.{{whvid|Grease and Flour a Pan Step 1.360p.mp4|Grease and Flour a Pan Step 1-preview.jpg}}",
                    "#Choose your flour.{{whvid|Grease and Flour a Pan Step 2.360p.mp4|Grease and Flour a Pan Step 2-preview.jpg}}",
                    "#Grease the pan.{{whvid|Grease and Flour a Pan Step 3.360p.mp4|Grease and Flour a Pan Step 3-preview.jpg}}",
                    "#Add the flour.{{whvid|Grease and Flour a Pan Step 4.360p.mp4|Grease and Flour a Pan Step 4-preview.jpg}}",
                    "#Add the batter. Your cake pans are now greased and floured and are ready for the batter.{{whvid|Grease and Flour a Pan Step 5.360p.mp4|Grease and Flour a Pan Step 5-preview.jpg}}"
                ],
                "removed": [
                    "[[Image:Grease and Flour a Pan Intro.jpg|right|300px]]Many recipes for baked goods call for the baking pan or cake pan to be greased and floured prior to adding the batter and baking. This is an important step in the baking process to ensure that the finished product doesn't stick to the sides of the pan. Even non-stick pans need to be greased and floured for some recipes. By greasing and flouring the pan you're creating 2 layers of non-stick protection. The greasing agent will allow the flour to adhere to it and as the cake bakes, it will cling to the flour and not to the side of the pan. When baked and cooled the product should release from the pan easily. To do this, all you'll need are the right ingredients and a little practice.",
                    "# Choose your greasing agent.{{largeimage|Grease and Flour a Pan Step 1.jpg}}",
                    "# Choose your flour.{{largeimage|Grease and Flour a Pan Step 2.jpg}}",
                    "# Grease the pan.{{largeimage|Grease and Flour a Pan Step 3.jpg}}",
                    "# Add the flour.{{largeimage|Grease and Flour a Pan Step 4.jpg}}",
                    "# Add the batter. Your cake pans are now greased and floured and are ready for the batter.{{largeimage|Grease and Flour a Pan Step 5.jpg}}"
                ]
            }
        },
        {
            "id": "12099921",
            "user": "ELamson38",
            "timestamp": "19:33, 13 December 2013",
            "anon": false,
            "size": "(3,587 bytes)",
            "change": 39,
            "summary": "(Intro Reworking Project--Please do not revert)",
            "is_minor": false,
            "is_expert": false,
            "status": "active",
            "contribution_type": "revert",
            "exact_contribution": {
                "added": [
                    "[[Image:Grease and Flour a Pan Intro.jpg|right|300px]]Many recipes for baked goods call for the baking pan or cake pan to be greased and floured prior to adding the batter and baking. This is an important step in the baking process to ensure that the finished product doesn't stick to the sides of the pan. Even non-stick pans need to be greased and floured for some recipes. By greasing and flouring the pan you're creating 2 layers of non-stick protection. The greasing agent will allow the flour to adhere to it and as the cake bakes, it will cling to the flour and not to the side of the pan. When baked and cooled the product should release from the pan easily. To do this, all you'll need are the right ingredients and a little practice."
                ],
                "removed": [
                    "[[Image:Grease and Flour a Pan Intro.jpg|right|300px]]Many recipes for baked goods call for the baking pan or cake pan to be greased and floured prior to adding the batter and baking. This is an important step in the baking process to ensure that the finished product doesn't stick to the sides of the pan. Even non-stick pans need to be greased and floured for some recipes. By greasing and flouring the pan you're creating 2 layers of non-stick protection. The greasing agent will allow the flour to adhere to it and as the cake bakes, it will cling to the flour and not to the side of the pan. When baked and cooled the product should release from the pan easily. Here's how to grease and flour a pan."
                ]
            }
        },
