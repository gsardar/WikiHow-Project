            "id": "13085991",
            "user": "Wikiphoto",
            "timestamp": "23:57, 25 March 2014",
            "anon": false,
            "size": "(3,156 bytes)",
            "change": -783,
            "summary": "(Removing all images from article.)",
            "is_minor": false,
            "is_expert": false,
            "status": "reverted",
            "contribution_type": "major_deletion",
            "reverted_by": "SarahB",
            "exact_contribution": {
                "added": [
                    "# Cut the copper wire. You need 2 strands about 1.5 feet (0.4572 m) long.",
                    "#* Use small wire cable cutters to cut the copper wire.",
                    "# Remove 1 inch (2.54 cm) of shielding from the ends of both strands.",
                    "#* The shielding is the plastic that covers the copper wire. Removing it can be achieved by carefully squeezing the cable cutter so that it cuts through the shielding but not the wire. The shielding can them be stripped from the ends with your hands.",
                    "# Use the nail to pierce 2 holes into the cork. The holes should be in the middle of the cork about 1 inch (2.54 cm) apart.",
                    "# Hold the 2 copper strands parallel to each other in the air.",
                    "# Place one end of each strand 2 inches (5.08 cm) inside the two holes drilled into the cork.",
                    "# Bend the end of the two strands inside the cork into a hook shape. The hook of each strand should curve the same way.",
                    "# Cut the iron wire into 1 1/2 to 2 inch (3.81 cm to 5.08 cm) strips. Make 5 strips.",
                    "# Twist the 5 iron wire strips together with your fingers.",
                    "# Place the twisted iron wire onto the copper hooks, making sure it touches both copper strands.",
                    "# Put the cork stopper into the glass jar.",
                    "# Take 1 strand of the copper wire not in the glass jar and wrap the end around 1 end of the battery. Repeat this for the other strand of copper wire and the other end of the battery."
                ],
                "removed": [
                    "# Cut the copper wire. You need 2 strands about 1.5 feet (0.4572 m) long.<br><br>[[Image:Make a Light Bulb Step 1.jpg|center|550px]]",
                    "#* Use small wire cable cutters to cut the copper wire.<br><br>[[Image:Make a Light Bulb Step 1Bullet1.jpg|center|550px]]",
                    "# Remove 1 inch (2.54 cm) of shielding from the ends of both strands.<br><br>[[Image:Make a Light Bulb Step 2.jpg|center|550px]]",
                    "#* The shielding is the plastic that covers the copper wire. Removing it can be achieved by carefully squeezing the cable cutter so that it cuts through the shielding but not the wire. The shielding can them be stripped from the ends with your hands.<br><br>[[Image:Make a Light Bulb Step 2Bullet1.jpg|center|550px]]",
                    "# Use the nail to pierce 2 holes into the cork. The holes should be in the middle of the cork about 1 inch (2.54 cm) apart.<br><br>[[Image:Make a Light Bulb Step 3.jpg|center|550px]]",
                    "# Hold the 2 copper strands parallel to each other in the air.<br><br>[[Image:Make a Light Bulb Step 4.jpg|center|550px]]",
                    "# Place one end of each strand 2 inches (5.08 cm) inside the two holes drilled into the cork.<br><br>[[Image:Make a Light Bulb Step 5.jpg|center|550px]]",
                    "# Bend the end of the two strands inside the cork into a hook shape. The hook of each strand should curve the same way.<br><br>[[Image:Make a Light Bulb Step 6.jpg|center|550px]]",
                    "# Cut the iron wire into 1 1/2 to 2 inch (3.81 cm to 5.08 cm) strips. Make 5 strips.<br><br>[[Image:Make a Light Bulb Step 7.jpg|center|550px]]",
                    "# Twist the 5 iron wire strips together with your fingers.<br><br>[[Image:Make a Light Bulb Step 8.jpg|center|550px]]",
                    "# Place the twisted iron wire onto the copper hooks, making sure it touches both copper strands.<br><br>[[Image:Make a Light Bulb Step 9.jpg|center|550px]]",
                    "# Put the cork stopper into the glass jar.<br><br>[[Image:Make a Light Bulb Step 10.jpg|center|550px]]",
                    "# Take 1 strand of the copper wire not in the glass jar and wrap the end around 1 end of the battery. Repeat this for the other strand of copper wire and the other end of the battery.<br><br>[[Image:Make a Light Bulb Step 11.jpg|center|550px]]"
                ]
            }
