            "summary": "",
            "is_minor": false,
            "is_expert": false,
            "status": "active",
            "contribution_type": "addition",
            "exact_contribution": {
                "added": [
                    "#*'''Check the graphite thickness.''' While larger thicknesses work, 0.5 mm seems to work best.",
                    "#*You can use any battery, but starting small is usually best. C or D batteries (1.5 V each) will do the trick.",
                    "#*If you're not getting enough light, try attaching your batteries [[#series| in series.]]"
                ],
                "removed": [
                    "#*'''Check the graphite thickness.''' While larger thickness work, .5mm seems to work best.",
                    "#*You can use any battery, but starting small is usually best. A C or D battery will do the trick.",
                    "#*If you're not getting enough light, try attaching your batteries [[#series| in a series.]]"
                ]
            }
        },
