            "change": 524,
            "summary": "(information about tsunami)",
            "is_minor": false,
            "is_expert": false,
            "status": "active",
            "contribution_type": "major_addition",
            "exact_contribution": {
                "added": [
                    "#*If you are in a tsunami prone area, you should know immediately of a location that is away from the coast and high off the ground and should practice proceeding to that location during earthquake drills. Tsunami are deadly waves formed after large earthquakes, and they can easily be up to {{convert|10|m|ft}} high or even higher. You should check your government's office of emergency management to see whether you live in a tsunami-prone area and the steps you can take to [[Prepare for a Tsunami|prepare for tsunami]]."
                ],
                "removed": []
            }
        },
