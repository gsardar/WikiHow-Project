        {
            "id": "6020646",
            "user": "Oliver",
            "timestamp": "04:29, 17 May 2011",
            "anon": false,
            "size": "(14,178 bytes)",
            "change": 2,
            "summary": "(Reverted edits by 74.179.215.254 (Talk); changed back to last version by 70.68.30.90)",
            "is_minor": true,
            "is_expert": false,
            "status": "active",
            "contribution_type": "revert",
            "exact_contribution": {
                "added": [
                    "{{fa}}[[Image:Paso Robles Earthquake 4744.jpg|right|250px]]An earthquake is a very dangerous natural disaster; particularly in the Pacific Rim region. In fact, scientists now believe that the highly populated Southern Californian area is long overdue for a massive earthquake along the San Andreas fault.<ref>Rong-Gong Lin Il, Study shakes up scientists' view of San Andreas earthquake risk, http://www.latimes.com/news/local/la-me-earthquake-fault-20100821,0,946323.story?track=rss</ref>",
                    "After an earthquake, your home may be a mess and you might be left without a water supply and energy. There are several things you can do to prepare for an earthquake before it happens, to minimize the damage and potential for injury in and around your home."
                ],
                "removed": [
                    "{{fa}}[[Image:Paso Robles arthquake 4744.jpg|right|250px]]An earthquake is a very dangerous natural disaster; particularly in the Pacific Rim region. In fact, scientists now believe that the highly populated Southern Californian area is long overdue for a massive earthquake along the San Andreas fault.<ref>Rong-Gong Lin Il, Study shakes up scientists' view of San Andreas earthquake risk, http://www.latimes.com/news/local/la-me-earthquake-fault-20100821,0,946323.story?track=rss</ref>",
