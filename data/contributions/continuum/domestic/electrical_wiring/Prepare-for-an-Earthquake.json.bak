            "id": "12167385",
            "user": "Jamie",
            "timestamp": "10:20, 20 December 2013",
            "anon": false,
            "size": "(12,741 bytes)",
            "change": -112,
            "summary": "(Reverted edits by 23.242.150.233 (Talk); changed back to last version by IGriffiths)",
            "is_minor": true,
            "is_expert": false,
            "status": "active",
            "contribution_type": "revert",
            "exact_contribution": {
                "added": [
                    "#*Overhead light fixtures should be braced to prevent them from falling.",
                    "#*If your house has a [[Inspect a Fireplace Chimney|chimney]], this can be a source of injury if it topples during an earthquake. Secure it to the walls of the house using galvanized metal angles and bands at the top, ceiling line, and base. The angles can be bolted to the wall, and to ceiling joists or rafters if you have cladding on the house. For the part of the chimney sitting above the roof-line, brace it to the roof."
                ],
                "removed": [
                    "#*Overhead light fixtures should be braced to prevent them from falling.as well, but be careful. You may be dealing with ruptured gas lines or flammable material spills.",
                    "#*If your house has a [[Inspect a Fireplace Chimney|chimney]]ddwwddddwdadawd, this can be a source of injury if it topples during an earthquake. Secure it to the walls of the house using galvanized metal angles and bands at the top, ceiling line, and base. The angles can be bolted to the wall, and to ceiling joists or rafters if you have cladding on the house. For the part of the chimney sitting above the roof-line, brace it to the roof."
                ]
            }
        },
