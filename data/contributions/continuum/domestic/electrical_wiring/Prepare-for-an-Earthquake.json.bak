            "id": "4714155",
            "user": "BR",
            "timestamp": "09:57, 16 June 2010",
            "anon": false,
            "size": "(6,514 bytes)",
            "change": 207,
            "summary": "(Reverted edits by 220.244.14.195 (Talk); changed back to last version by BR)",
            "is_minor": true,
            "is_expert": false,
            "status": "reverted",
            "contribution_type": "revert",
            "reverted_by": "DaniFree",
