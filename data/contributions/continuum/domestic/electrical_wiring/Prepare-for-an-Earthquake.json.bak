        {
            "id": "33558794",
            "user": "MiscBot",
            "timestamp": "07:00, 18 July 2025",
            "anon": false,
            "size": "(16,021 bytes)",
            "change": 23,
            "summary": "(Automatic external link checking: updating and/or deleting links that are broken)",
            "is_minor": true,
            "is_expert": false,
            "status": "active",
            "contribution_type": "addition",
            "exact_contribution": {
                "added": [
                    "#Practice \"drop, cover and hold on\" until it becomes second nature. In a real earthquake, this is your number one defense. Drop to the floor, take cover under a sturdy desk or table and hold on firmly. Be prepared for shaking and falling objects. You should practice this in every room of the house, knowing your protected areas no matter where you are when an earthquake hits.<ref>https://www.fema.gov/emergency-managers/risk-management/earthquake</ref>[[Image:Prepare for an Earthquake Step 2 Version 3.jpg|center]]"
                ],
                "removed": [
                    "#Practice \"drop, cover and hold on\" until it becomes second nature. In a real earthquake, this is your number one defense. Drop to the floor, take cover under a sturdy desk or table and hold on firmly. Be prepared for shaking and falling objects. You should practice this in every room of the house, knowing your protected areas no matter where you are when an earthquake hits.<ref>https://www.fema.gov/earthquake-safety-home</ref>[[Image:Prepare for an Earthquake Step 2 Version 3.jpg|center]]"
                ]
            }
        },
        {
            "id": "33496949",
            "user": "MiscBot",
            "timestamp": "09:01, 19 June 2025",
            "anon": false,
            "size": "(15,998 bytes)",
            "change": 4,
            "summary": "(Automatic external link checking: updating and/or deleting links that are broken)",
            "is_minor": true,
