        {
            "id": "9216400",
            "user": "Wikiphoto",
            "timestamp": "07:01, 15 February 2013",
            "anon": false,
            "size": "(3,404 bytes)",
            "change": 46,
            "summary": "(Enlarging and centering Steps photos)",
            "is_minor": false,
            "is_expert": false,
            "status": "active",
            "contribution_type": "addition",
            "exact_contribution": {
                "added": [
                    "# Inspect the fuse. When a fuse is blown, you may see several indicators.<br><br>[[Image:Check Fuses Step 1.jpg|center|550px]]",
                    "#* Check to see if the very fine wire in the fuse casing is broken with no discoloration to the casing. This most likely indicates that there is no major short on the circuit.<br><br>[[Image:Check Fuses Step 1Bullet1.jpg|center|550px]]",
                    "#* Look to see if the very fine wire in the fuse casing is broken with slight discoloration to the fuse casing. This, again, most likely indicates that there is no major short on the circuit.<br><br>[[Image:Check Fuses Step 1Bullet2.jpg|center|550px]]",
                    "#* Verify that the very fine wire in the fuse casing is broken and the casing is discolored. This indicates that there is a major short on the circuit.<br><br>[[Image:Check Fuses Step 1Bullet3.jpg|center|550px]]",
                    "# Find a multimeter to use to check the fuse. A multimeter is a tool used frequently when working with electricity.<br><br>[[Image:Check Fuses Step 2.jpg|center|550px]]",
                    ""
                ],
                "removed": [
                    "# [[Image:Check Fuses Step 1.jpg|right|300px]]Inspect the fuse. When a fuse is blown, you may see several indicators.",
                    "#* [[Image:Check Fuses Step 1Bullet1.jpg|right|300px]]Check to see if the very fine wire in the fuse casing is broken with no discoloration to the casing. This most likely indicates that there is no major short on the circuit.",
                    "#* [[Image:Check Fuses Step 1Bullet2.jpg|right|300px]]Look to see if the very fine wire in the fuse casing is broken with slight discoloration to the fuse casing. This, again, most likely indicates that there is no major short on the circuit.",
                    "#* [[Image:Check Fuses Step 1Bullet3.jpg|right|300px]]Verify that the very fine wire in the fuse casing is broken and the casing is discolored. This indicates that there is a major short on the circuit.",
                    "# [[Image:Check Fuses Step 2.jpg|right|300px]]Find a multimeter to use to check the fuse. A multimeter is a tool used frequently when working with electricity."
                ]
            }
        },
