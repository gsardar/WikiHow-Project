            "exact_contribution": {
                "added": [
                    "{{fa}}Got an odd piece that you want to display, but aren't sure what to do with it? How about making a lamp? You can make lamps out of almost anything, and they provide decor and ambience, in addition to making great conversation pieces. If your craftsy side is feeling neglected and you want to spark it back into action, here's a perfect project for you."
                ],
                "removed": [
                    "{{fa}}{{nointroimg}}Got an odd piece that you want to display, but aren't sure what to do with it? How about making a lamp? You can make lamps out of almost anything, and they provide decor and ambience, in addition to making great conversation pieces. If your craftsy side is feeling neglected and you want to spark it back into action, here's a perfect project for you."
                ]
            }
        },
        {
            "id": "10681501",
            "user": "Votebot",
            "timestamp": "16:55, 5 August 2013",
            "anon": false,
            "size": "(8,972 bytes)",
            "change": 0,
            "summary": "(reordering tips and warnings based on votes)",
            "is_minor": false,
