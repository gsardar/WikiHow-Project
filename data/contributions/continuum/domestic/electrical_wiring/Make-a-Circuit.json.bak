            "id": "30250981",
            "user": "Seymour Edits",
            "timestamp": "23:34, 28 January 2022",
            "anon": false,
            "size": "(7,586 bytes)",
            "change": -351,
            "summary": "(wikihaus internal edit--please do not roll this back.)",
            "is_minor": false,
