            "exact_contribution": {
                "added": [
                    "#*Add 1/4 inch to the height of the opening. This additional 1/4 inch will allow the unit to be angled slightly downward on the outside to prevent condensation and rainwater from collecting in the unit and leaking inside the house. If you have a specific point for the top of the opening, add this 1/4 inch to the bottom for the new line to cut.",
                    "#*Repeat this procedure for the bottom corners, but remember to have the protrusion here 1/4 to 1/2 inch greater than measured at the top. This creates a position for the case or sleeve that is tipped downward to the outside and will minimize the chance for condensation and rainwater from collecting and leaking inside."
                ],
                "removed": [
                    "#*Add 1/4 inch to the height of the opening. This additional 1/4 inch will allow the unit to be angled slightly downward on the outside to prevent condensation and rain water from collecting in the unit and leaking inside the house. If you have a specific point for the top of the opening, add this 1/4 inch to the bottom for the new line to cut.",
                    "#*Repeat this procedure for the bottom corners, but remember to have the protrusion here 1/4 to 1/2 inch greater than measured at the top. This creates a position for the case or sleeve that is tipped downward to the outside and will minimize the chance for condensation and rain water from collecting and leaking inside."
                ]
            }
        },
