        {
            "id": "20143573",
            "user": "Votebot",
            "timestamp": "08:32, 3 May 2016",
            "anon": false,
            "size": "(29,009 bytes)",
            "change": 0,
            "summary": "(reordering tips and warnings based on votes)",
            "is_minor": true,
            "is_expert": false,
            "status": "reverted",
            "contribution_type": "adjustment",
            "reverted_by": "Anna",
            "exact_contribution": {
                "added": [
                    "*Use the smaller, easier to work and less expensive #14 (14 gauge) copper Romex cable if the circuit is protected by a 15 amp fuse or circuit breaker.  Very few three-way circuits switch loads on a 20 amp circuit.",
                    "*One wire per terminal.  Do not connect more than one wire under a screw terminal. Additionally, the wire should wrap clockwise around the screw.  Only wrap solid wire around a terminal screw.  Stranded wire will require fork or ring terminals to be installed (crimped or soldered) on the wire and the terminal screw tightened down on the fork or ring terminal.",
                    "*Never mix wire sizes or materials (copper and aluminum)."
                ],
                "removed": [
                    "*Use the smaller, easier to work and less expensive #14 (14 gauge) copper Romex cable if the circuit is protected by a 15 amp fuse or circuit breaker.  Very few three-way circuits switch loads on a 20 amp circuit.",
                    "*One wire per terminal.  Do not connect more than one wire under a screw terminal. Additionally, the wire should wrap clockwise around the screw.  Only wrap solid wire around a terminal screw.  Stranded wire will require fork or ring terminals to be installed (crimped or soldered) on the wire and the terminal screw tightened down on the fork or ring terminal.",
                    "*Never mix wire sizes or materials (copper and aluminum)."
                ]
            }
        },
