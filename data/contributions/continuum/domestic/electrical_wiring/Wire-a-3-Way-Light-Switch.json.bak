            "exact_contribution": {
                "added": [
                    "*When remodeling, always check the fuse or circuit breaker on which new lights or outlets are being installed.",
                    "*Never install a gauge wire on a circuit that is protected by a breaker or fuse that has a higher capacity than the wire you're using: 6 gauge - 50A, 8 gauge - 40A, 10 gauge - 30A, 12 gauge - 20A, 14 gauge - 15A.  Do not connect smaller wires to the electric panel, unless they are the leads of a transformer for a doorbell or similar circuit."
                ],
                "removed": [
                    "*Never install a gauge wire on a circuit that is protected by a breaker or fuse that has a higher capacity than the wire you're using: 6 gauge - 50A, 8 gauge - 40A, 10 gauge - 30A, 12 gauge - 20A, 14 gauge - 15A.  Do not connect smaller wires to the electric panel, unless they are the leads of a transformer for a doorbell or similar circuit.",
                    "*When remodeling, always check the fuse or circuit breaker on which new lights or outlets are being installed."
                ]
            }
