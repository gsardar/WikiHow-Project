            "id": "5890774",
            "user": "JackHerrick",
            "timestamp": "02:08, 19 April 2011",
            "anon": false,
            "size": "(6,264 bytes)",
            "change": -20,
            "summary": "(format)",
            "is_minor": false,
            "is_expert": false,
            "status": "active",
            "contribution_type": "deletion",
            "exact_contribution": {
                "added": [
                    "=== Australian Installations Method ===",
                    "",
                    "# Disconnect circuit power (and check no power on circuit)",
                    "# Connect circuit Earth (Green) and circuit Neutral (Black)to light (Green & Blue respectively).",
                    "# Connect circuit Active (Red) to switch ONE common terminal (middle); Connect Switching Wire (White) to Terminal 1; Connect second switching wire (white or red) to terminal 2.",
                    "# On switch both connect switching wires (terminal 1 and terminal 2 respectively on switch 2) and the common terminal to Red Wire (this then gets connected to light).",
                    "# At light fitting connect switch one-switching wire 1 to switch two switching wire 1; and connect switch one-switching wire 2 to switch two-switching wire 2.",
                    "# Connect switch 2 red wire (connected to switch 2 common terminal) to active terminal on light fitting (Red or Brown).",
                    "#[[Image:3_Way_Switches_3.jpg|right|184px|thumb|Power from Switch to Light to Switch]][[Image:3_Way_Switches_2.jpg|right|184px|thumb|Power from Light to Switch to Switch]][[Image:3_Way_Switches_1.jpg|right|184px|thumb|Power from Switch to Switch to Light]]",
                    "",
                    "== Tips =="
                ],
                "removed": [
                    "#(Alternative instructions for Australian installations)",
                    "#1 Disconnect circuit power (and check no power on circuit)",
                    "#2 Connect circuit Earth (Green) and circuit Neutral (Black)to light (Green & Blue respectively).",
                    "#3 Connect circuit Active (Red) to switch ONE common terminal (middle); Connect Switching Wire (White) to Terminal 1; Connect second switching wire (white or red) to terminal 2.",
                    "#4 On switch both connect switching wires (terminal 1 and terminal 2 respectively on switch 2) and the common terminal to Red Wire (this then gets connected to light).",
                    "#5 At light fitting connect switch one-switching wire 1 to switch two switching wire 1; and connect switch one-switching wire 2 to switch two-switching wire 2.",
                    "#6 Connect switch 2 red wire (connected to switch 2 common terminal) to active terminal on light fitting (Red or Brown).",
                    "#[[Image:3_Way_Switches_3.jpg|right|184px|thumb|Power from Switch to Light to Switch]][[Image:3_Way_Switches_2.jpg|right|184px|thumb|Power from Light to Switch to Switch]][[Image:3_Way_Switches_1.jpg|right|184px|thumb|Power from Switch to Switch to Light]]== Tips =="
                ]
            }
        },
