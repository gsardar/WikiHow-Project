        {
            "id": "7410384",
            "user": "Stevecon",
            "timestamp": "14:18, 10 March 2012",
            "anon": false,
            "size": "(14,804 bytes)",
            "change": 3,
            "summary": "(→‎Tips)",
            "is_minor": true,
            "is_expert": false,
            "status": "reverted",
            "contribution_type": "addition",
            "reverted_by": "Loni_lings",
            "exact_contribution": {
                "added": [
                    "*[[Image:Fuse panel wiring by clowns..jpg|right|184px|thumb|A terminal strip with 10 wires connected that have fork terminals crimped on the ends.  Crimped terminals are easily and quickly installed.  They prevent strands of wire from coming in contact with something unintended and make it easy to connect stranded wires to screw terminals. ]]One terminal = one wire.  It is not permissible to connect more than one wire under a screw terminal. Additionally, wire should wrap clockwise around the screw.  Only solid wire is to be wrapped around a terminal screw.  Stranded wire will require installation of fork or ring terminals to be installed (crimped or soldered) on the wire and the terminal screw tightened down on the fork or ring terminal."
                ],
                "removed": [
                    "*[[Image:Fuse panel wiring by clowns..jpg|right|184px|thumb|A terminal strip with 10 wires connected that have fork terminals crimped on the ends.  Crimped terminals are easily and quickly installed.  They prevent strands of wire from coming in contact with something unintended and make it easy to connect the wires to a screw terminals. ]]One terminal = one wire.  It is not permissible to connect more than one wire under a screw terminal. Additionally, wire should wrap clockwise around the screw.  Only solid wire is to be wrapped around a terminal screw.  Stranded wire will require installation of fork or ring terminals to be installed (crimped or soldered) on the wire and the terminal screw tightened down on the fork or ring terminal."
                ]
            }
        },
