        {
            "id": "27931203",
            "user": "WikiHaus Trainee",
            "timestamp": "01:54, 2 April 2020",
            "anon": false,
            "size": "(17,030 bytes)",
            "change": 17,
            "summary": "(Adding relevant wikihow link)",
            "is_minor": false,
            "is_expert": false,
            "status": "active",
            "contribution_type": "addition",
            "exact_contribution": {
                "added": [
                    "#Grade the ground at the bottom of the hole. Once the site has been excavated, the next step is to even out what will become the floor of the pool as much as possible. This will involve covering the bottom surface with a thick layer of washed gravel subsoil, which is then raked and compressed until it’s perfectly [[Level a Pool|level]].[[Image:Build a Swimming Pool Step 9 Version 5.jpg|center]]"
                ],
                "removed": [
                    "#Grade the ground at the bottom of the hole. Once the site has been excavated, the next step is to even out what will become the floor of the pool as much as possible. This will involve covering the bottom surface with a thick layer of washed gravel subsoil, which is then raked and compressed until it’s perfectly level.[[Image:Build a Swimming Pool Step 9 Version 5.jpg|center]]"
                ]
