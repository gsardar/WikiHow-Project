        {
            "id": "32666944",
            "user": "WikiHow Horizon",
            "timestamp": "18:08, 21 July 2024",
            "anon": false,
            "size": "(11,037 bytes)",
            "change": -233,
            "summary": "(Removing broken link/s)",
