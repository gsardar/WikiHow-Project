            "contribution_type": "addition",
            "exact_contribution": {
                "added": [
                    "* If your parents make you feel degraded, or you are doing your best to be a good child but nothing is changing, it may be a sign of emotional abuse. Talk to an adult you trust (like a teacher or grandparent) about how you feel."
                ],
                "removed": []
            }
