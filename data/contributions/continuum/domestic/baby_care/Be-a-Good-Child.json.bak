        {
            "id": "21222024",
            "user": "WikihowSaver",
            "timestamp": "21:18, 26 October 2016",
            "anon": false,
            "size": "(14,682 bytes)",
            "change": 0,
            "summary": "(RCP reverted edits by 95.102.155.193 (talk) to  revision #21163138 by Galactic Radiance)",
            "is_minor": false,
            "is_expert": false,
            "status": "reverted",
            "contribution_type": "revert",
            "reverted_by": "CelesteTu",
            "exact_contribution": {
                "added": [
                    "#*No child (or adult) can solve every problem herself.  Your parents want to give you assistance when you need it, and will see your willingness to ask as a positive sign.  Don’t expect them to solve every problem for you, though — that is a sign of immaturity."
                ],
                "removed": [
                    "#*No child (or adult) can solve every problem himself.  Your parents want to give you assistance when you need it, and will see your willingness to ask as a positive sign.  Don’t expect them to solve every problem for you, though — that is a sign of immaturity."
                ]
            }
        },
        {
