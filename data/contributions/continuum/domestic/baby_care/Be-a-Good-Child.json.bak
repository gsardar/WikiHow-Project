        {
            "id": "22591639",
            "user": "ExoticComet",
            "timestamp": "09:29, 10 June 2017",
            "anon": false,
            "size": "(14,682 bytes)",
            "change": -27,
            "summary": "(RCP reverted edits by 144.138.84.68 (talk) to  revision #22061164 by InfernoTerra)",
            "is_minor": false,
            "is_expert": false,
            "status": "reverted",
            "contribution_type": "revert",
            "reverted_by": "Batreeq",
            "exact_contribution": {
                "added": [
                    "#Accept your responsibilities.  It is easy to say that a good child listens to her parents (and other authority figures) and does what she is told.  While this is normally true, it is more important that children learn to take responsibility for what they need to do.  As a child who strives to be your best, you need to accept that there are things you have to do, for the benefit of yourself and others.<ref>http://www.parents.com/toddlers-preschoolers/development/social/qualities-to-nurture/</ref>[[Image:Be a Good Boy Step 13.jpg|center]]"
                ],
                "removed": [
                    "#Accept your responsibilities.  It is easy to say that a good child listens to her parents (and other authority figures) and does what she is told.  While this is normally true, it is more important that children learn to take responsibility for what they need to do.  As a child who strives to be your best, you need to accept that there are things you have to do, for the benefit of yourself and others.<ref>http://www.parents.com/toddlers- 1ii2jwkdkdjoi tgjkfdjldlkfpreschoolers/development/social/qualities-to-nurture/</ref>[[Image:Be a Good Boy Step 13.jpg|center]]"
                ]
            }
        },
