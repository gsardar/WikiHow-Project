# ==========================================
# GITHUB PRUNING: MINIMAL CORE CODEBASE
# ==========================================

# 1. Ignore EVERYTHING by default
*

# 2. Re-allow MINIMAL root files
!.gitignore
!README.md
!requirements.txt
!setup.py
!run_all.py
!settings.ini

# 3. Re-allow core code directories
!deepseek/
!deepseek/**
!wikihow/
!wikihow/**
!scripts/
!scripts/**

# 4. EXPLICIT EXCLUSIONS (High Security)
.env
.env*
github_sync.py
wikihow/tor_manager.py
wikihow/tor_service.py
scripts/test_tor_*.py
tool/

# 5. Filter out non-essential sub-folders
scripts/legacy/
scripts/scratch/
scripts/tests/
scripts/downloaded_files/
**/__pycache__/
**/*.pyc
**/*.log

# 6. Metadata & Data Exclusions
data/
browser_session/
docs/
draft/
demo/
instruct/
notebooks/
plots/
research_taxonomy/
tests/
test_*.py
scratch/
tmp/
github/
*.rar
*.png
*.webp
*.txt
*.pdf
*.csv
*.xlsx
*.ipynb
*.html
*.old
*.exe
*.dll
*.lock
